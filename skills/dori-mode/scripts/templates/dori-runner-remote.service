[Unit]
Description=Dori runner (reports lane observations on this machine to the supervisor)
# Its own unit, separate from hc's: a runner restart never touches the hc core or the lanes running in it. Wants= and
# After= only (never Requires=/BindsTo=): at boot hc's core comes up first, and an hc failure leaves the runner up to report it.
Wants=hc-core.service
After=hc-core.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# No EnvironmentFile: a runner host holds no supervisor or Discord credentials, only its own runner key.
Type=simple
Environment=LANG=C.UTF-8
Environment=PATH=@PATH@
UMask=0077
ExecStart=@BUN@ %h/.dori/runner/bin/dori.js runner serve --label @LABEL@ --listen @LISTEN@
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
