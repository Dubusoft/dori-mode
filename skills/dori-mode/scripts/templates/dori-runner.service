[Unit]
Description=Dori local runner (shadow mode: reports lane observations to the supervisor, changes nothing)
# Its own unit, separate from herdr-server.service: a runner restart never touches herdr or the lanes in it.
Wants=herdr-server.service
After=herdr-server.service
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=dori-failure-notify@%n.service

[Service]
# The runner reconnects to the supervisor by itself (backoff 1 s to 60 s), so it starts whether or not the supervisor
# is up. An unsafe ~/.dori/runner (symlink, wrong mode or owner) exits 1 with RUNNER_DIR_UNSAFE on stderr.
Type=simple
WorkingDirectory={{WORK_DIR}}
EnvironmentFile={{ENV_FILE}}
Environment=DORI_CONFIG={{CONFIG}}
Environment=PATH={{PATH}}
Environment=LANG=C.UTF-8
UMask=0077
ExecStart={{DORI_BIN}} runner serve
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
